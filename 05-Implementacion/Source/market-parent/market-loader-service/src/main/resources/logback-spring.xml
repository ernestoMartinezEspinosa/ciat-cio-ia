<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========================= -->
    <!-- VARIABLES -->
    <!-- ========================= -->

    <property name="APP_NAME" value="market-loader-service"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} | %level | ${APP_NAME} | %thread | %logger{36} | correlationId=%X{correlationId} | %msg%n"/>

    <!-- ========================= -->
    <!-- CONSOLE APPENDER -->
    <!-- ========================= -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- FILE APPENDER -->
    <!-- ========================= -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- LOG LEVELS -->
    <!-- ========================= -->

    <!-- Root -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Kafka (menos ruido) -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="INFO"/>

    <!-- Spring framework -->
    <logger name="org.springframework" level="WARN"/>

    <!-- Tu microservicio -->
    <logger name="mx.com.ciat.cio.market.platform" level="DEBUG"/>

</configuration>